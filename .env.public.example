# Settings for showing the app to other people from your own computer.
# Copy this file to .env.public (git ignores it) and fill in DATABASE_URL.
# Use the READ-ONLY database login here, never the owner login.
# See "Use a read-only database login" in the README.

DATABASE_URL=

# Search only. No AI key is involved and visitors cannot ask for written answers.
ENABLE_ASK=false
SEARCH_MODES=vector
DEFAULT_SEARCH_MODE=vector

# Behind a tunnel every visitor looks like one address, so these two limits act
# together as one shared budget. Keep them low.
RATE_LIMIT_PER_MIN=60
GLOBAL_RATE_LIMIT_PER_MIN=120
MAX_CONCURRENT_SEARCHES=2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
