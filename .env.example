# Copy this file to .env and fill in your own values. Never commit .env.

# Optional for the server. The web app asks each visitor for their own key.
# Needed only for local evals and the MCP server's ask_docs tool.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_DEV=openai/gpt-4o-mini
OPENROUTER_MODEL_EVAL=openai/gpt-4o-mini

# Neon pooled connection string
DATABASE_URL=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EVAL_MAX_COST_USD=2

# Web API settings. For a public search-only site, see the README.
# ENABLE_ASK=false
# SEARCH_MODES=vector
# DEFAULT_SEARCH_MODE=vector
# RATE_LIMIT_PER_MIN=30
# GLOBAL_RATE_LIMIT_PER_MIN=200
# MAX_CONCURRENT_SEARCHES=2
# CORS_ORIGINS=http://localhost:3000
