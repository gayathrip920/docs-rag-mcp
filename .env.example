# Copy this file to .env and fill in your own values. Never commit .env.

# Optional for the server. The web app asks each visitor for their own key.
# Needed only for local evals and the MCP server's ask_docs tool.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_DEV=openai/gpt-4o-mini
OPENROUTER_MODEL_EVAL=openai/gpt-4o-mini

# Neon pooled connection string
DATABASE_URL=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EVAL_MAX_COST_USD=2
